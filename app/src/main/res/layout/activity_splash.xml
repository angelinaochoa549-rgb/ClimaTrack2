<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Imagen de fondo completa (aire acondicionado, hojas y olas azules) -->
    <ImageView
        android:id="@+id/imgFondoSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_splash" />

    <!-- Bloque Central: Logo, Título, Subtítulo y Loader -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Logo Circular (Copo de nieve y llave inglesa) -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_climatrack" />

        <!-- Título Dividido para Colores Oficiales en Preview -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clima"
                android:textColor="#0D50B5"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track"
                android:textColor="#12BFE0"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtítulo de la app -->
        <TextView
            android:id="@+id/tvSubtituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Gestión de Mantenimiento\nde Equipos de Climatización"
            android:textColor="#29466F"
            android:textSize="15sp" />

        <!-- Progress Bar Circular -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="40dp"
            android:indeterminateTint="#68D0BC" />

        <!-- Texto Cargando... -->
        <TextView
            android:id="@+id/tvCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cargando..."
            android:textColor="#29466F"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>