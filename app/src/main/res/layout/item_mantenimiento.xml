<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- LÍNEA DE TIEMPO (Icono + Línea vertical) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIconoTipo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Tipo de Servicio"
            android:src="@android:drawable/checkbox_on_background" />

        <!-- Línea conectora entre ítems -->
        <View
            android:id="@+id/viewLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#D0DCEB" />

    </LinearLayout>

    <!-- DETALLES DEL MANTENIMIENTO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Fila de Encabezado: Fecha, Hora y Badge de Tipo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-15"
                android:textColor="#172F55"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="10:30 AM"
                android:textColor="#536A88"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="PREVENTIVO"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Orden de Servicio -->
        <TextView
            android:id="@+id/tvOrden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Orden: ORD-8842"
            android:textColor="#1553A5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Técnico asignado -->
        <TextView
            android:id="@+id/tvTecnico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Técnico: Carlos Pérez"
            android:textColor="#536A88"
            android:textSize="13sp" />

        <!-- Descripción detallada -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Limpieza de filtros y verificación de niveles de refrigerante."
            android:textColor="#333333"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>