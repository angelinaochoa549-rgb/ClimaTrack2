<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClimaTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Bottom Navigation Custom Style -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

        <!-- Shape and Typography -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ClimaTrack.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ClimaTrack.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.ClimaTrack.Large</item>
    </style>

    <style name="Theme.ClimaTrack" parent="Base.Theme.ClimaTrack" />

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.ClimaTrack.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.ClimaTrack.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.ClimaTrack.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Refined Chips and Components -->
    <style name="StatusChip">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="indicatorColor">#33FFFFFF</item>
        <item name="itemIconTint">@color/bottom_nav_colors_white</item>
        <item name="itemTextColor">@color/bottom_nav_colors_white</item>
        <item name="backgroundTint">#0D47A1</item>
    </style>

</resources>